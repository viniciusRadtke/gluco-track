# Copy to .env.local and fill in. .env.local is git-ignored.
#
# Both values below are safe to ship in the browser bundle: the anon key only
# grants what the row level security policies allow, and every table requires a
# session. The service role key must never appear in this file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Temporary, development only.
#
# The sign-in screen lands in a later pull request (RF-AUT-01). Until then the
# app signs in with these credentials on start so the screens can read and write
# real data under real row level security policies. The code that reads them is
# excluded from production builds, and both this block and that code are deleted
# when the sign-in screen arrives.

VITE_DEV_PATIENT_EMAIL=
VITE_DEV_PATIENT_PASSWORD=
